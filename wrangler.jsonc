{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram-x-hero",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-12",
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/bot", "/hooks/*", "/setup/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // No database_id on purpose: the first deploy creates this database in your Cloudflare account, and later
      // deploys reuse the one already attached to the Worker (matched by this name). The Worker creates its tables itself.
      "database_name": "notpanel",
      "migrations_dir": "migrations"
    }
  ],
  // Expired typing indicators are cleaned up on the scheduled run.
  "triggers": { "crons": ["* * * * *"] },
   "vars": {
    "OWNER_IDS": "7062424671"
  }
}
